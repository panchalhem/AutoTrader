# Copy this file to automation/.env and fill in your own values.
# automation/.env is gitignored — never commit real credentials.
#
# Capital.com does NOT use your regular account login password here.
# Generate a dedicated API key first: Capital.com app -> Settings ->
# API integrations -> Generate new key (requires 2FA on your account).
# You set a custom password for that key at creation time — that is
# CAPITAL_API_PASSWORD below, not your account password. The key itself
# is shown only once, at creation — copy it immediately.

CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=your-capital-login-email@example.com

# "demo" (recommended while testing) or "live"
CAPITAL_ENV=demo

# --- Zerodha (Kite Connect) ---
# ZERODHA_API_KEY / ZERODHA_API_SECRET: from developers.kite.trade after
# creating an app (the free "Personal" tier covers order placement + GTT,
# which is all this script uses).
#
# ZERODHA_USER_ID / ZERODHA_PASSWORD / ZERODHA_TOTP_SECRET: your actual
# Zerodha login credentials, used ONLY to automate the daily login (Kite
# access tokens expire every day at 6am — there is no way around a fresh
# login each trading day). ZERODHA_TOTP_SECRET is the base32 secret shown
# when you first set up TOTP 2FA (not a 6-digit code, not your app PIN) —
# if you only have the authenticator app and not the original secret,
# you'll need to reset 2FA on Zerodha to get a fresh one.
#
# This is more sensitive than the Capital.com credentials above: it's your
# real account password, not a separate revocable API key. Use a strong,
# dedicated password and keep this file out of anywhere it could leak.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Zerodha has NO sandbox/paper-trading account. "demo" here is simulated —
# it behaves exactly like dry-run (nothing is ever sent to the real
# broker) so the demo/live mental model stays consistent with Capital.com,
# without ever mislabeling a real order as fake-money safe. Only "live"
# places real Zerodha orders.
ZERODHA_ENV=demo

# --- Capital split (2026-09-02) ---
# What fraction of total account equity BREAKOUT_INTRADAY trades risk against.
# Everything else (BREAKOUT_SWING, INBOUNDTRADEALGO) risks against the rest
# (1 - INTRADAY_CAPITAL_PCT) — there is deliberately no separate
# "investment pool" variable, so the two can never drift out of sync.
# Applies identically to both brokers (auto_trader.py and zerodha_trader.py).
# Only affects NEW trade entries; positions already open when this changes
# keep whatever size they were opened with.
INTRADAY_CAPITAL_PCT=0.20
